# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
_check.py

# --- Environment / secrets ---
.env
.env.local
.env.*.local

# --- Node / Next.js (frontend, phase 3+) ---
node_modules/
.next/
out/
frontend/.env*.local

# --- Data & generated output ---
# Never commit real production data, generated reports, or per-run
# temp artifacts. The leading **/ matters: these folders live under
# backend/, not at the repo root where this .gitignore sits, and a
# pattern with a slash in the middle (like "data/**/*.csv") only
# matches a data/ folder AT the .gitignore's own location without it.
**/data/**/*.csv
**/data/**/*.xlsx
**/outputs/reports/*.pdf
**/outputs/tmp/
!**/data/sample_weaving/.gitkeep
!**/outputs/reports/.gitkeep

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- Logs ---
*.log